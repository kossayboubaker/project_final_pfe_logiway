# ========================================
# LOGIWAY — .gitignore
# ========================================

# ========================================
# FICHIERS SENSIBLES — SECRETS / CLÉ API
# ========================================
# Fichiers d'environnement (contiennent des secrets)
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
.env.example

# Scripts de configuration sensibles
kc_setup.ps1
**/*kc_setup*.ps1
*.bat

# Fichiers SQL (peuvent contenir des données sensibles)
*.sql
# Garder les migrations Flyway (nécessaires au projet)
!**/db/migration/*.sql
!**/migration/*.sql

# Clés privées / Certificats
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cert
*.crt

# Fichiers de credentials Google / Firebase / Cloud
*-service-account*.json
*-credentials*.json
firebase-adminsdk*.json
google-services.json
serviceAccountKey*.json

# Fichiers contenant des tokens / secrets
*secret*
!**/secret-management/  # Dossier de code, pas de secrets
*.secret

# ========================================
# JAVA / MAVEN / SPRING BOOT
# ========================================
backend/target/
**/target/
*.jar
*.war
*.class
*.log
*.pid

# ========================================
# NODE / ANGULAR / NPM
# ========================================
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
package-lock.json.bak

# ========================================
# PYTHON
# ========================================
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
venv*/
.venv/
*.egg-info/
*.egg
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.whl

# ========================================
# IDE / ÉDITEURS
# ========================================
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.factorypath
*.sublime-project
*.sublime-workspace

# ========================================
# SYSTÈME D'EXPLOITATION
# ========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ========================================
# DOCKER — DONNÉES LOCALES
# ========================================
docker-data/
mysql-data/
keycloak-data/

# ========================================
# LOGS / RAPPORTS
# ========================================
logs/
**/logs/
*.log
reports/
coverage/
test-results/

# ========================================
# MODÈLES ML / DONNÉES VOLUMINEUSES
# ========================================
*.joblib
*.pkl
*.h5
*.model
*.onnx
*.pt
*.pth
# Garder les petits fichiers de données d'entraînement si nécessaires
# *.csv

# ========================================
# DIVERS
# ========================================
*.tmp
*.bak
*.orig
*.swp
.terraform/
terraform.tfstate*
