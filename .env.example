# ========================================
# LOGIWAY PLATFORM - VARIABLES D'ENVIRONNEMENT
# ========================================
# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# ========================================
# BASE DE DONNÉES MYSQL
# ========================================
MYSQL_ROOT_PASSWORD=logiway2024
MYSQL_DATABASE=logiway
MYSQL_USER=logiway_user
MYSQL_PASSWORD=logiway_pass

# ========================================
# KEYCLOAK — AUTHENTIFICATION
# ========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=logiway
KEYCLOAK_CLIENT_ID=logiway
# URL interne (Spring Boot → Keycloak via réseau Docker)
KEYCLOAK_SERVER_URL=http://keycloak:8080
# URL externe (Angular dans le navigateur → Keycloak via port exposé)
# Remplacer localhost par l'IP réelle pour accès réseau
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# ========================================
# GOOGLE GEMINI API
# ========================================
# Obtenir votre clé API sur: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ========================================
# HUGGINGFACE API
# ========================================
HF_API_TOKEN=your_hf_token_here

# ========================================
# OPENWEATHER API
# ========================================
OPENWEATHER_API_KEY=your_openweather_key_here

# ========================================
# CONFIGURATION BACKEND
# ========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ========================================
# URLs FRONTEND / BACKEND
# ========================================
# Remplacer localhost par l'IP réelle pour accès réseau
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8080

# ========================================
# CORS — ORIGINES AUTORISÉES
# ========================================
# Séparer par des virgules. Ajouter l'IP de la machine pour accès réseau.
# Ex: http://localhost:4200,http://192.168.1.50:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:8180

# ========================================
# SERVICES IA/ML — URLs internes Docker
# ========================================
PAUSE_AI_SERVICE_URL=http://pause-ai:5000
RECLAMATION_AI_SERVICE_URL=http://reclamation-ai:5001
RAG_SERVICE_URL=http://rag-service:8001

# ========================================
# PAUSE AI SERVICE — Configuration ML
# ========================================
OSRM_URL=https://router.project-osrm.org
MODEL_PATH=data/pause_model.joblib
TRAINING_DATA_PATH=data/training_data.csv

# ========================================
# RÉCLAMATION AI — Seuils de validation
# ========================================
TOXICITY_THRESHOLD=0.55
SEMANTIC_THRESHOLD=0.25

# ========================================
# RAG SERVICE — Configuration
# ========================================
RAG_LOG_LEVEL=info
RAG_WORKERS=2

# ========================================
# SIMULATEUR GPS — Configuration
# ========================================
SIMULATION_STEP_SECONDS=2.5
SIMULATION_SPEED_KMH=55

# ========================================
# CONFIGURATION RÉSEAU
# ========================================
NETWORK_SUBNET=172.20.0.0/16
