# ========================================
# LOGIWAY PLATFORM - VARIABLES D'ENVIRONNEMENT
# ========================================
# Copier ce fichier en .env et remplir les valeurs

# ========================================
# BASE DE DONNÉES MYSQL
# ========================================
MYSQL_ROOT_PASSWORD=logiway2024
MYSQL_DATABASE=logiway
MYSQL_USER=logiway_user
MYSQL_PASSWORD=logiway_pass

# ========================================
# GOOGLE GEMINI API
# ========================================
# Obtenir votre clé API sur: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ========================================
# CONFIGURATION BACKEND
# ========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ========================================
# SERVICES IA/ML - URLs
# ========================================
PAUSE_AI_SERVICE_URL=http://pause-ai:5000
RECLAMATION_AI_SERVICE_URL=http://reclamation-ai:5001
RAG_SERVICE_URL=http://rag-service:8001

# ========================================
# PAUSE AI SERVICE - Configuration ML
# ========================================
OSRM_URL=https://router.project-osrm.org
MODEL_PATH=data/pause_model.joblib
TRAINING_DATA_PATH=data/training_data.csv

# ========================================
# RÉCLAMATION AI - Seuils de validation
# ========================================
TOXICITY_THRESHOLD=0.55
SEMANTIC_THRESHOLD=0.25

# ========================================
# RAG SERVICE - Configuration
# ========================================
RAG_LOG_LEVEL=info
RAG_WORKERS=2

# ========================================
# CONFIGURATION RÉSEAU
# ========================================
NETWORK_SUBNET=172.20.0.0/16
